{
  "compilerOptions": {
    "lib": ["es5", "es6", "es7"],
    "target": "es2017",
    "module": "es2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@base/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@lib/*": ["src/lib/*"],
      "@features/*": ["src/feature/*"],
    },
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
  },
  "include": ["src/**/*", "src/**/*.d.ts", "src/**/*.ts", "prisma/**/*", "."],
  "exclude": ["node_modules", "dist"]
}
