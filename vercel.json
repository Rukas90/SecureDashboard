{
    "buildCommand": "yarn workspace @project/shared build && yarn workspace client build",
    "outputDirectory": "client/dist",
    "installCommand": "yarn install",
    "framework": null,
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://securedashboard-d6to.onrender.com/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}